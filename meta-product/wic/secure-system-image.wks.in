# TODO
# Note: Using vdb here as QEMU will by default map the efy-system-partition-image to vda.

bootloader --ptable gpt

# Separate kernel partitions to verify UKIs prior to loading rootfs with dm-verity
part --ondisk vdb --uuid ${BOOT_A_PARTUUID} --source bootimg-partition --fstype=squashfs --fixed-size 50M --align 4096
part --ondisk vdb --uuid ${BOOT_B_PARTUUID} --source empty --fstype=squashfs --fixed-size 50M --align 4096

# Rootfs partitions
part / --ondisk vdb --uuid ${ROOTFS_A_PARTUUID} --source rootfs --fstype=ext4 --fixed-size 250M --label ${ROOTFS_A_NAME} --align 4096
part / --ondisk vdb --uuid ${ROOTFS_B_PARTUUID} --source empty --fstype=ext4 --fixed-size 250M --label ${ROOTFS_B_NAME} --align 4096

part /data --ondisk vdb --fstype=ext4 --size 400M --label data